<!DOCTYPE html><html lang="pt-BR"><head>  <meta charset="UTF-8"><meta
name="viewport"
content="width=device-width, initial-scale=1.0, viewport-fit=cover"
>

  <title>CleanSync · Chat</title>  <link rel="preconnect" href="https://fonts.googleapis.com">  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  >  <link
    rel="manifest"
    href="manifest.json"
  ><meta
name="theme-color"
content="#15151A"
>

  <link
    rel="stylesheet"
    href="style.css?v=11"
  >  <!-- SUPABASE -->  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>  <!-- ONESIGNAL -->  <script
    src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
    defer
  ></script>  <script>

    window.OneSignalDeferred =
      window.OneSignalDeferred || [];

    OneSignalDeferred.push(
      async function(OneSignal) {

        try {

          await OneSignal.init({

            appId:
              "6ece3179-2303-4614-a752-18378c461644",

            serviceWorkerPath:
              "onesignal/OneSignalSDKWorker.js",

            serviceWorkerParam: {
              scope: "/onesignal/"
            }

          });

        } catch(error) {

          console.warn(
            "OneSignal não inicializado:",
            error
          );

        }

      }
    );

  </script></head><body>  <div
    id="snackbar"
    class="snackbar"
  ></div>  <!-- ======================================================
       TOPBAR
  ====================================================== -->  <div class="topbar"><div class="brand">

  <div class="mark"></div>

  <div>

    <div class="name">
      CleanSync
    </div>

    <div class="sub">
      CHAT DA LIMPEZA
    </div>

  </div>

</div>


<div class="who">

  <span
    class="sync-dot"
    id="connectionStatus"
  >

    <span class="dot"></span>

    CONECTANDO

  </span>


  <span id="topWhoName"></span>


  <button
    type="button"
    class="btn btn-outline"
    onclick="openAiModal()"
  >
    🤖 IA
  </button>


  <button
    type="button"
    class="btn btn-ghost"
    onclick="goBack()"
  >
    Voltar
  </button>

</div>

  </div>  <!-- ======================================================
       CONTEÚDO
  ====================================================== -->  <main class="wrap"><!-- ====================================================
     HERO
==================================================== -->

<div class="page-hero">

  <div class="eyebrow">
    COMUNICAÇÃO
  </div>

  <h1 id="chatTitle">
    Chat
  </h1>

  <p
    class="lede"
    id="chatSubtitle"
  >
    Conversa relacionada à limpeza.
  </p>

</div>



<!-- ====================================================
     INFORMAÇÕES DA LIMPEZA
==================================================== -->

<div
  class="chat-task-info"
  id="chatTaskInfo"
>

  <div class="chat-task-info-item">

    <span>
      REFERÊNCIA
    </span>

    <strong id="taskRef">
      —
    </strong>

  </div>


  <div class="chat-task-info-item">

    <span>
      DATA
    </span>

    <strong id="taskDate">
      —
    </strong>

  </div>


  <div class="chat-task-info-item">

    <span>
      STATUS
    </span>

    <strong
      id="taskStatus"
      data-status=""
    >
      —
    </strong>

  </div>

</div>



<!-- ====================================================
     CHAT
==================================================== -->

<section class="card chat-card">


  <!-- MENSAGENS -->

  <div
    id="messages"
    class="chat-messages"
  >

    <div class="chat-loading">

      <div class="spinner"></div>

      <span>
        Carregando conversa...
      </span>

    </div>

  </div>



  <!-- ==================================================
       INPUT
  ================================================== -->

  <form
    id="messageForm"
    class="chat-input-area"
  >

    <textarea
      id="messageInput"
      rows="1"
      maxlength="2000"
      placeholder="Digite uma mensagem..."
      autocomplete="off"
      spellcheck="true"
    ></textarea>


    <button
      type="submit"
      class="btn btn-accent chat-send"
      id="sendButton"
      aria-label="Enviar mensagem"
      title="Enviar mensagem"
    >
      ➤
    </button>

  </form>


</section>

  </main>  <!-- ======================================================
       MODAL — ASSISTENTE IA
  ====================================================== -->  <div
    class="notify-overlay"
    id="aiModal"
    style="display:none;"
  >

    <div
      class="notify-modal"
      style="max-width:460px; text-align:left;"
    >

      <div class="notify-emoji">
        🤖
      </div>

      <h3>
        Assistente CleanSync
      </h3>

      <p style="margin-bottom:14px;">
        Pergunte sobre esta limpeza: horário, endereço, checklist, status etc.
      </p>

      <div
        id="aiReply"
        style="
          min-height:56px;
          max-height:220px;
          overflow-y:auto;
          color:var(--cream);
          font-size:13.5px;
          line-height:1.6;
          white-space:pre-wrap;
          background:var(--dark2);
          border:1px solid var(--border);
          border-radius:var(--radius-sm);
          padding:12px 14px;
          margin-bottom:14px;
        "
      ></div>

      <textarea
        id="aiInput"
        rows="2"
        maxlength="2000"
        placeholder="Ex: Quando está marcada minha limpeza?"
        style="
          width:100%;
          padding:12px 14px;
          border-radius:12px;
          border:1.5px solid var(--border-strong);
          background:var(--dark2);
          color:var(--cream);
          font-family:var(--sans);
          font-size:14px;
          margin-bottom:14px;
          resize:none;
          box-sizing:border-box;
        "
      ></textarea>

      <div class="notify-actions">

        <button
          type="button"
          class="btn btn-accent"
          id="aiSendBtn"
          onclick="askAi()"
        >
          Perguntar
        </button>

        <button
          type="button"
          class="btn btn-ghost"
          onclick="closeAiModal()"
        >
          Fechar
        </button>

      </div>

    </div>

  </div>  <!-- ======================================================
       APP COMMON
  ====================================================== -->  <script src="app-common.js?v=11"></script>  <script>

    /* ======================================================
       ESTADO GLOBAL
    ====================================================== */

    let currentUser = null;

    let currentProfile = null;

    /*
     * Sessão local completa (inclui password_hash), usada
     * apenas para autenticar chamadas de RPC/Edge Function —
     * nunca exibida na tela. Opção B não tem JWT do Supabase Auth.
     */
    let localSession = null;

    let cleaningId = null;

    let currentCleaning = null;

    let conversationId = null;

    let realtimeChannel = null;

    let sendingMessage = false;



    /* ======================================================
       INICIALIZAÇÃO
    ====================================================== */

    document.addEventListener(
      'DOMContentLoaded',
      initChat
    );


    async function initChat() {

      try {

        /*
         * 1. Obtém task da URL.
         *
         * Exemplo:
         *
         * chat.html?task=UUID
         */

        const params =
          new URLSearchParams(
            window.location.search
          );


        cleaningId =
          params.get('task');


        if (!cleaningId) {

          showError(
            'Nenhuma limpeza foi selecionada.'
          );

          return;

        }


        /*
         * 2. Verifica sessão diretamente.
         *
         * Não usamos requireRole('cliente')
         * porque o chat é compartilhado entre
         * cliente, profissional e administrador.
         */

        localSession =
          (typeof getSession === 'function')
            ? getSession()
            : null;


        const context =
          getCurrentContext();


        if (!context) {

          return;

        }


        currentUser =
          context.user;

        currentProfile =
          context.profile;


        updateTopUser();


        /*
         * 3. Inicializa conversa.
         */

        await initializeConversation();


      } catch(error) {

        console.error(
          'CleanSync Chat:',
          error
        );


        showError(
          'Não foi possível abrir o chat.'
        );

      }

    }



    /* ======================================================
       CONTEXTO DO USUÁRIO
       (Opção B — sessão local, sem sb.auth)
    ====================================================== */

    function getCurrentContext() {

      /*
       * getSession() do app-common.js é SÍNCRONO nesse modelo
       * e retorna { id, username, name, role, password_hash, address }
       * ou null se não houver sessão.
       */

      const session =
        (typeof getSession === 'function')
          ? getSession()
          : null;


      if (
        !session ||
        !session.id ||
        !session.username ||
        !session.password_hash
      ) {

        window.location.href =
          'index.html';

        return null;

      }


      const user = {
        id: session.id,
        username: session.username
      };


      const profile = {
        id: session.id,
        role: session.role || null,
        name: session.name || session.username || ''
      };


      return {
        user,
        profile
      };

    }



    /* ======================================================
       USUÁRIO NO TOPO
    ====================================================== */

    function updateTopUser() {

      const element =
        document.getElementById(
          'topWhoName'
        );


      if (!element) return;


      element.textContent =
        (
          currentProfile &&
          (
            currentProfile.name ||
            currentProfile.full_name
          )
        ) ||
        (
          currentUser &&
          currentUser.email
        ) ||
        '';

    }



    /* ======================================================
       INICIALIZAR CONVERSA
    ====================================================== */

    async function initializeConversation() {

      try {

        setConnectionStatus(
          'CONECTANDO'
        );


        /*
         * A função SQL cria ou recupera
         * a conversa da limpeza.
         *
         * Ela utiliza:
         *
         * conversations.task_id
         *
         * e NÃO:
         *
         * cleaning_id
         * cleaning_request_id
         */

        if (
          !localSession ||
          !localSession.username ||
          !localSession.password_hash
        ) {

          throw new Error(
            'Sessão inválida. Faça login novamente.'
          );

        }


        const {
          data,
          error
        } =
          await sb.rpc(
            'create_cleaning_conversation',
            {
              p_cleaning_id:
                cleaningId,

              p_username:
                localSession.username,

              p_password_hash:
                localSession.password_hash
            }
          );


        if (error) {

          throw error;

        }


        /*
         * O RPC deve retornar
         * o UUID da conversa.
         */

        conversationId =
          extractConversationId(data);


        if (!conversationId) {

          console.error(
            'Retorno do RPC:',
            data
          );

          throw new Error(
            'A função de conversa não retornou o ID da conversa.'
          );

        }


        /*
         * Carrega limpeza.
         */

        await loadCleaning();


        /*
         * Carrega mensagens.
         */

        await loadMessages();


        /*
         * Realtime.
         */

        subscribeToMessages();


        /*
         * Input.
         */

        setupInput();


      } catch(error) {

        console.error(
          'initializeConversation:',
          error
        );


        showError(
          'Não foi possível abrir o chat: ' +
          (
            error.message ||
            'erro desconhecido'
          )
        );

      }

    }



    /* ======================================================
       EXTRair ID DA CONVERSA
    ====================================================== */

    function extractConversationId(data) {

      /*
       * Caso normal:
       *
       * UUID diretamente.
       */

      if (
        typeof data === 'string'
      ) {

        return data;

      }


      /*
       * Caso RPC retorne objeto.
       */

      if (
        data &&
        typeof data === 'object'
      ) {

        return (
          data.id ||
          data.conversation_id ||
          data.conversationId ||
          null
        );

      }


      return null;

    }



    /* ======================================================
       CARREGAR LIMPEZA
    ====================================================== */

    async function loadCleaning() {

      const {
        data,
        error
      } =
        await sb
          .from('cleaning_requests')
          .select(`
            id,
            ref_code,
            client_name,
            client_email,
            address,
            date,
            time,
            status,
            professional_id,
            client_id,
            price,
            laundry_service
          `)
          .eq(
            'id',
            cleaningId
          )
          .single();


      if (error) {

        throw error;

      }


      if (!data) {

        throw new Error(
          'Limpeza não encontrada.'
        );

      }


      currentCleaning =
        data;


      updateCleaningInterface(
        data
      );

    }



    /* ======================================================
       INTERFACE DA LIMPEZA
    ====================================================== */

    function updateCleaningInterface(
      data
    ) {

      const title =
        document.getElementById(
          'chatTitle'
        );


      if (title) {

        title.textContent =
          'Chat · ' +
          (
            data.ref_code ||
            'Limpeza'
          );

      }


      const subtitle =
        document.getElementById(
          'chatSubtitle'
        );


      if (subtitle) {

        subtitle.textContent =
          data.address ||
          'Conversa da limpeza';

      }


      const ref =
        document.getElementById(
          'taskRef'
        );


      if (ref) {

        ref.textContent =
          data.ref_code ||
          '—';

      }


      const date =
        document.getElementById(
          'taskDate'
        );


      if (date) {

        date.textContent =
          formatTaskDate(
            data.date,
            data.time
          );

      }


      const status =
        document.getElementById(
          'taskStatus'
        );


      if (status) {

        status.textContent =
          formatStatus(
            data.status
          );

        status.dataset.status =
          data.status || '';

      }

    }



    /* ======================================================
       CARREGAR MENSAGENS
    ====================================================== */

    async function loadMessages() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      container.innerHTML = `

        <div class="chat-loading">

          <div class="spinner"></div>

          <span>
            Carregando mensagens...
          </span>

        </div>

      `;


      const {
        data,
        error
      } =
        await sb
          .from('messages')
          .select(`
            id,
            conversation_id,
            sender_id,
            content,
            created_at
          `)
          .eq(
            'conversation_id',
            conversationId
          )
          .order(
            'created_at',
            {
              ascending: true
            }
          );


      if (error) {

        throw error;

      }


      if (
        !data ||
        !data.length
      ) {

        renderEmptyChat();

        return;

      }


      container.innerHTML =
        data
          .map(
            renderMessage
          )
          .join('');


      scrollMessages();

    }



    /* ======================================================
       RENDERIZAR MENSAGEM
    ====================================================== */

    function renderMessage(
      message
    ) {

      const mine =
        String(
          message.sender_id
        ) ===
        String(
          currentUser.id
        );


      const date =
        new Date(
          message.created_at
        );


      const time =
        date.toLocaleTimeString(
          'pt-BR',
          {
            hour: '2-digit',
            minute: '2-digit'
          }
        );


      const day =
        date.toLocaleDateString(
          'pt-BR',
          {
            day: '2-digit',
            month: '2-digit'
          }
        );


      return `

        <div
          class="chat-message ${mine ? 'mine' : 'theirs'}"
          data-message-id="${escapeAttribute(message.id)}"
        >

          <div class="chat-bubble">

            <div class="chat-content">
              ${escapeHtml(
                message.content || ''
              )}
            </div>

            <div class="chat-time">
              ${day} · ${time}
            </div>

          </div>

        </div>

      `;

    }



    /* ======================================================
       CHAT VAZIO
    ====================================================== */

    function renderEmptyChat() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      container.innerHTML = `

        <div class="chat-empty">

          <div class="chat-empty-icon">
            💬
          </div>

          <strong>
            Inicie a conversa
          </strong>

          <span>
            Envie uma mensagem para
            o outro participante desta limpeza.
          </span>

        </div>

      `;

    }



    /* ======================================================
       REALTIME
    ====================================================== */

    function subscribeToMessages() {

      if (!conversationId) {

        return;

      }


      /*
       * Remove canal anterior.
       */

      if (realtimeChannel) {

        sb.removeChannel(
          realtimeChannel
        );

        realtimeChannel =
          null;

      }


      const channelName =
        'cleansync-chat-' +
        String(
          conversationId
        ) +
        '-' +
        Date.now();


      realtimeChannel =
        sb
          .channel(
            channelName
          )


          .on(

            'postgres_changes',

            {
              event: 'INSERT',

              schema: 'public',

              table: 'messages',

              filter:
                'conversation_id=eq.' +
                conversationId
            },

            payload => {

              try {

                if (
                  !payload ||
                  !payload.new
                ) {

                  return;

                }


                appendRealtimeMessage(
                  payload.new
                );


              } catch(error) {

                console.error(
                  'Realtime message:',
                  error
                );

              }

            }

          )


          .subscribe(

            status => {

              console.log(
                'CleanSync Chat Realtime:',
                status
              );


              if (
                status ===
                'SUBSCRIBED'
              ) {

                setConnectionStatus(
                  'ONLINE'
                );

              }

              else if (
                status ===
                'CHANNEL_ERROR'
              ) {

                setConnectionStatus(
                  'ERRO'
                );

              }

              else {

                setConnectionStatus(
                  'CONECTANDO'
                );

              }

            }

          );

    }



    /* ======================================================
       ADICIONAR MENSAGEM REALTIME
    ====================================================== */

    function appendRealtimeMessage(
      message
    ) {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      /*
       * Evita duplicação.
       */

      const existing =
        container.querySelector(
          `[data-message-id="${escapeAttribute(message.id)}"]`
        );


      if (existing) {

        return;

      }


      /*
       * Remove estado vazio.
       */

      const empty =
        container.querySelector(
          '.chat-empty'
        );


      if (empty) {

        container.innerHTML =
          '';

      }


      container.insertAdjacentHTML(
        'beforeend',
        renderMessage(
          message
        )
      );


      scrollMessages();

    }



    /* ======================================================
       STATUS DA CONEXÃO
    ====================================================== */

    function setConnectionStatus(
      status
    ) {

      const element =
        document.getElementById(
          'connectionStatus'
        );


      if (!element) return;


      let text =
        'CONECTANDO';


      let opacity =
        '1';


      if (
        status ===
        'ONLINE'
      ) {

        text =
          'ONLINE';

      }

      else if (
        status ===
        'ERRO'
      ) {

        text =
          'OFFLINE';

        opacity =
          '.45';

      }


      element.innerHTML = `

        <span
          class="dot"
          style="opacity:${opacity}"
        ></span>

        ${text}

      `;

    }



    /* ======================================================
       ENVIAR MENSAGEM
    ====================================================== */

    document
      .getElementById(
        'messageForm'
      )
      .addEventListener(
        'submit',
        sendMessage
      );


    async function sendMessage(
      event
    ) {

      event.preventDefault();


      if (sendingMessage) {

        return;

      }


      if (!conversationId) {

        showSnackbar(
          'Chat ainda não está pronto.'
        );

        return;

      }


      if (!currentUser) {

        showSnackbar(
          'Sessão expirada.'
        );

        return;

      }


      const input =
        document.getElementById(
          'messageInput'
        );


      const button =
        document.getElementById(
          'sendButton'
        );


      if (
        !input ||
        !button
      ) {

        return;

      }


      const content =
        input.value.trim();


      if (!content) {

        return;

      }


      if (
        content.length >
        2000
      ) {

        showSnackbar(
          'A mensagem não pode ultrapassar 2000 caracteres.'
        );

        return;

      }


      sendingMessage =
        true;


      input.disabled =
        true;

      button.disabled =
        true;


      try {

        /*
         * Insere na tabela:
         *
         * messages
         *
         * conversation_id
         * sender_id
         * content
         */

        const {
          data,
          error
        } =
          await sb
            .from('messages')
            .insert({

              conversation_id:
                conversationId,

              sender_id:
                currentUser.id,

              content:
                content

            })
            .select(`
              id,
              conversation_id,
              sender_id,
              content,
              created_at
            `)
            .single();


        if (error) {

          throw error;

        }


        /*
         * Mostra imediatamente.
         *
         * Se o Realtime chegar depois,
         * appendRealtimeMessage()
         * detectará a duplicação.
         */

        if (data) {

          appendRealtimeMessage(
            data
          );

        }


        input.value =
          '';

        autoResizeInput();

        input.focus();


      } catch(error) {

        console.error(
          'Erro ao enviar mensagem:',
          error
        );


        showSnackbar(
          'Erro ao enviar mensagem: ' +
          (
            error.message ||
            'erro desconhecido'
          )
        );


      } finally {

        sendingMessage =
          false;

        input.disabled =
          false;

        button.disabled =
          false;

        input.focus();

      }

    }



    /* ======================================================
       ASSISTENTE IA
       (usa a Edge Function gemini-chat;
       a chave do Gemini nunca aparece aqui)
    ====================================================== */

    function openAiModal() {

      const modal =
        document.getElementById(
          'aiModal'
        );

      if (!modal) return;

      modal.style.display =
        'flex';

      const input =
        document.getElementById(
          'aiInput'
        );

      if (input) {

        setTimeout(
          () => input.focus(),
          100
        );

      }

    }


    function closeAiModal() {

      const modal =
        document.getElementById(
          'aiModal'
        );

      if (modal) {

        modal.style.display =
          'none';

      }

    }


    async function askAi() {

      const input =
        document.getElementById(
          'aiInput'
        );

      const replyBox =
        document.getElementById(
          'aiReply'
        );

      const button =
        document.getElementById(
          'aiSendBtn'
        );


      if (
        !input ||
        !replyBox ||
        !button
      ) {

        return;

      }


      const message =
        input.value.trim();


      if (!message) {

        return;

      }


      if (!cleaningId) {

        showSnackbar(
          'Limpeza não identificada.'
        );

        return;

      }


      button.disabled =
        true;

      const originalLabel =
        button.textContent;

      button.textContent =
        'Pensando...';

      replyBox.textContent =
        '';


      try {

        const {
          data,
          error
        } =
          await sb.functions.invoke(
            'gemini-chat',
            {
              body: {
                taskId: cleaningId,
                message,
                username: localSession?.username,
                passwordHash: localSession?.password_hash
              }
            }
          );


        if (error) {

          throw error;

        }


        replyBox.textContent =
          (
            data &&
            data.reply
          ) ||
          'A IA não retornou uma resposta.';


      } catch(error) {

        console.error(
          'askAi:',
          error
        );

        /*
         * O chat humano nunca deve
         * quebrar por causa da IA.
         */

        replyBox.textContent =
          '⚠️ Não foi possível falar com a IA agora. O chat continua funcionando normalmente.';

      } finally {

        button.disabled =
          false;

        button.textContent =
          originalLabel;

        input.value =
          '';

      }

    }



    /* ======================================================
       INPUT
    ====================================================== */

    function setupInput() {

      const input =
        document.getElementById(
          'messageInput'
        );


      if (!input) return;


      /*
       * Auto resize.
       */

      input.addEventListener(
        'input',
        autoResizeInput
      );


      /*
       * Enter envia.
       *
       * Shift + Enter quebra linha.
       */

      input.addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' &&
            !event.shiftKey
          ) {

            event.preventDefault();


            const form =
              document.getElementById(
                'messageForm'
              );


            if (form) {

              form.requestSubmit();

            }

          }

        }
      );


      /*
       * Ctrl/Cmd + Enter também envia.
       */

      input.addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' &&
            (
              event.ctrlKey ||
              event.metaKey
            )
          ) {

            event.preventDefault();


            const form =
              document.getElementById(
                'messageForm'
              );


            if (form) {

              form.requestSubmit();

            }

          }

        }
      );


      setTimeout(
        () => {

          input.focus();

        },
        200
      );

    }



    function autoResizeInput() {

      const input =
        document.getElementById(
          'messageInput'
        );


      if (!input) return;


      input.style.height =
        'auto';


      input.style.height =
        Math.min(
          input.scrollHeight,
          120
        ) +
        'px';

    }



    /* ======================================================
       SCROLL
    ====================================================== */

    function scrollMessages() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      requestAnimationFrame(
        () => {

          container.scrollTop =
            container.scrollHeight;

        }
      );

    }



    /* ======================================================
       VOLTAR
    ====================================================== */

    function goBack() {

      const role =
        String(
          currentProfile &&
          currentProfile.role ||
          ''
        ).toLowerCase();


      /*
       * Admin e profissional
       * voltam para profissional.html.
       */

      if (
        role === 'admin' ||
        role === 'professional' ||
        role === 'profissional'
      ) {

        window.location.href =
          'profissional.html';

        return;

      }


      /*
       * Cliente.
       */

      window.location.href =
        'cliente.html';

    }



    /* ======================================================
       STATUS DA LIMPEZA
    ====================================================== */

    function formatStatus(
      status
    ) {

      switch(status) {

        case 'pending':
          return 'Pendente';

        case 'in-progress':
          return 'Em andamento';

        case 'completed':
          return 'Concluída';

        case 'cancelled':
          return 'Cancelada';

        default:
          return status || '—';

      }

    }



    /* ======================================================
       DATA DA LIMPEZA
    ====================================================== */

    function formatTaskDate(
      date,
      time
    ) {

      if (!date) {

        return '—';

      }


      try {

        const value =
          date +
          (
            time
              ? 'T' + time
              : 'T00:00:00'
          );


        const d =
          new Date(
            value
          );


        if (
          Number.isNaN(
            d.getTime()
          )
        ) {

          return date;

        }


        const formatted =
          d.toLocaleDateString(
            'pt-BR',
            {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            }
          );


        return time
          ? formatted +
            ' · ' +
            time
          : formatted;

      } catch(error) {

        return date;

      }

    }



    /* ======================================================
       ESCAPE HTML
    ====================================================== */

    function escapeHtml(
      value
    ) {

      return String(
        value ?? ''
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /'/g,
          '&#039;'
        );

    }



    /* ======================================================
       ESCAPE ATTRIBUTE
    ====================================================== */

    function escapeAttribute(
      value
    ) {

      return String(
        value ?? ''
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        );

    }



    /* ======================================================
       SNACKBAR
    ====================================================== */

    function showSnackbar(
      message
    ) {

      /*
       * Se o app-common já possui
       * showSnackbar, usa a função global.
       */

      const commonSnackbar =
        window.showSnackbar;


      if (
        typeof commonSnackbar ===
        'function' &&
        commonSnackbar !== showSnackbar
      ) {

        commonSnackbar(
          message
        );

        return;

      }


      const snackbar =
        document.getElementById(
          'snackbar'
        );


      if (!snackbar) {

        return;

      }


      snackbar.textContent =
        message;


      snackbar.classList.add(
        'show'
      );


      clearTimeout(
        window.__cleanSyncSnackbarTimer
      );


      window.__cleanSyncSnackbarTimer =
        setTimeout(
          () => {

            snackbar.classList.remove(
              'show'
            );

          },
          3000
        );

    }



    /* ======================================================
       ERRO
    ====================================================== */

    function showError(
      message
    ) {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) {

        return;

      }


      container.innerHTML = `

        <div class="chat-error">

          <div class="chat-error-icon">
            ⚠️
          </div>

          <strong>
            Não foi possível abrir o chat
          </strong>

          <span>
            ${escapeHtml(message)}
          </span>

          <button
            type="button"
            class="btn btn-ghost"
            onclick="goBack()"
          >
            Voltar
          </button>

        </div>

      `;

    }



    /* ======================================================
       LIMPEZA DO REALTIME
    ====================================================== */

    window.addEventListener(
      'beforeunload',
      () => {

        if (
          realtimeChannel
        ) {

          sb.removeChannel(
            realtimeChannel
          );

          realtimeChannel =
            null;

        }

      }
    );

  </script>  <!-- ======================================================
       ESTILOS DO CHAT
  ====================================================== -->  <style>

    /* ======================================================
       INFORMAÇÕES DA TAREFA
    ====================================================== */

    .chat-task-info {

      display:grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:10px;

      margin-bottom:14px;

    }


    .chat-task-info-item {

      min-width:0;

      padding:12px 14px;

      border:
        1px solid
        var(--border);

      border-radius:12px;

      background:
        var(--dark3);

      box-sizing:border-box;

    }


    .chat-task-info-item span {

      display:block;

      margin-bottom:5px;

      font-family:
        var(--mono);

      font-size:9px;

      letter-spacing:.08em;

      color:
        var(--muted);

    }


    .chat-task-info-item strong {

      display:block;

      overflow:hidden;

      text-overflow:ellipsis;

      white-space:nowrap;

      color:
        var(--cream);

      font-size:13px;

    }


    .chat-task-info-item
    strong[data-status="completed"] {

      color:
        #6ee7b7;

    }


    .chat-task-info-item
    strong[data-status="in-progress"] {

      color:
        var(--pink-light);

    }


    .chat-task-info-item
    strong[data-status="pending"] {

      color:
        #fbbf24;

    }


    .chat-task-info-item
    strong[data-status="cancelled"] {

      color:
        #f87171;

    }



    /* ======================================================
       CARD
    ====================================================== */

    .chat-card {

      padding:0;

      overflow:hidden;

      position:relative;

    }



    /* ======================================================
       MENSAGENS
    ====================================================== */

    .chat-messages {

      height:520px;

      overflow-y:auto;

      padding:24px;

      display:flex;

      flex-direction:column;

      gap:10px;

      background:

        radial-gradient(
          circle at 10% 20%,
          rgba(196,26,72,.06),
          transparent 35%
        ),

        var(--dark2);

      scroll-behavior:smooth;

      box-sizing:border-box;

    }



    /* ======================================================
       MENSAGEM
    ====================================================== */

    .chat-message {

      display:flex;

      width:100%;

      animation:
        chatMessageIn
        .18s
        ease-out;

    }


    @keyframes chatMessageIn {

      from {

        opacity:0;

        transform:
          translateY(4px);

      }

      to {

        opacity:1;

        transform:
          translateY(0);

      }

    }


    .chat-message.mine {

      justify-content:flex-end;

    }


    .chat-message.theirs {

      justify-content:flex-start;

    }



    /* ======================================================
       BALÃO
    ====================================================== */

    .chat-bubble {

      max-width:
        min(
          75%,
          520px
        );

      padding:
        11px 14px;

      border-radius:16px;

      border:
        1px solid
        var(--border);

      background:
        var(--dark3);

      box-shadow:
        0 4px 14px
        rgba(0,0,0,.08);

      box-sizing:border-box;

    }


    .chat-message.mine
    .chat-bubble {

      background:
        linear-gradient(
          135deg,
          var(--wine),
          var(--pink)
        );

      border-color:
        rgba(255,255,255,.12);

      border-bottom-right-radius:
        5px;

    }


    .chat-message.theirs
    .chat-bubble {

      border-bottom-left-radius:
        5px;

    }



    /* ======================================================
       TEXTO
    ====================================================== */

    .chat-content {

      font-size:14px;

      line-height:1.55;

      color:
        var(--cream);

      white-space:pre-wrap;

      overflow-wrap:anywhere;

      word-break:break-word;

    }



    /* ======================================================
       HORÁRIO
    ====================================================== */

    .chat-time {

      margin-top:5px;

      font-family:
        var(--mono);

      font-size:9px;

      opacity:.65;

      text-align:right;

    }



    /* ======================================================
       INPUT
    ====================================================== */

    .chat-input-area {

      display:flex;

      align-items:flex-end;

      gap:10px;

      padding:14px;

      background:
        var(--dark3);

      border-top:
        1px solid
        var(--border);

      box-sizing:border-box;

    }


    .chat-input-area textarea {

      flex:1;

      resize:none;

      max-height:120px;

      min-height:44px;

      padding:
        12px 14px;

      border-radius:12px;

      border:
        1.5px solid
        var(--border-strong);

      background:
        var(--dark2);

      color:
        var(--cream);

      font-family:
        var(--sans);

      font-size:14px;

      line-height:1.4;

      box-sizing:border-box;

    }


    .chat-input-area textarea:focus {

      outline:none;

      border-color:
        var(--pink);

      box-shadow:
        0 0 0 3px
        rgba(196,26,72,.15);

    }


    .chat-input-area textarea:disabled {

      opacity:.6;

      cursor:not-allowed;

    }



    /* ======================================================
       BOTÃO ENVIAR
    ====================================================== */

    .chat-send {

      width:48px;

      min-width:48px;

      height:44px;

      padding:0;

      font-size:18px;

      display:flex;

      align-items:center;

      justify-content:center;

    }


    .chat-send:disabled {

      opacity:.5;

      cursor:not-allowed;

    }



    /* ======================================================
       VAZIO
    ====================================================== */

    .chat-empty {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      text-align:center;

      color:
        var(--muted);

      gap:8px;

    }


    .chat-empty-icon {

      font-size:40px;

      margin-bottom:5px;

    }


    .chat-empty strong {

      color:
        var(--cream);

      font-family:
        var(--display);

      font-size:22px;

    }


    .chat-empty span {

      max-width:320px;

      font-size:12px;

      line-height:1.5;

    }



    /* ======================================================
       LOADING
    ====================================================== */

    .chat-loading {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      gap:12px;

      color:
        var(--muted);

      font-size:12px;

    }



    /* ======================================================
       ERRO
    ====================================================== */

    .chat-error {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      text-align:center;

      gap:10px;

      padding:30px;

      color:
        var(--muted);

      box-sizing:border-box;

    }


    .chat-error-icon {

      font-size:40px;

    }


    .chat-error strong {

      color:
        var(--cream);

      font-family:
        var(--display);

      font-size:20px;

    }


    .chat-error span {

      max-width:480px;

      font-size:12px;

      line-height:1.5;

      overflow-wrap:anywhere;

    }



    /* ======================================================
       MOBILE
    ====================================================== */

    @media(max-width:700px) {

      .chat-task-info {

        grid-template-columns:
          1fr;

      }


      .chat-messages {

        height:
          calc(
            100vh - 360px
          );

        min-height:380px;

        padding:16px;

      }


      .chat-bubble {

        max-width:85%;

      }


      .chat-input-area {

        position:sticky;

        bottom:0;

        padding:10px;

      }


      .chat-input-area textarea {

        font-size:14px;

      }

    }



    /* ======================================================
       MOBILE PEQUENO
    ====================================================== */

    @media(max-width:420px) {

      .chat-messages {

        min-height:340px;

        padding:12px;

      }


      .chat-send {

        width:44px;

        min-width:44px;

      }


      .chat-bubble {

        max-width:90%;

      }

    }

  </style>  <!-- ======================================================
       SERVICE WORKER
  ====================================================== -->  <script>

    if (
      'serviceWorker' in navigator
    ) {

      navigator.serviceWorker
        .register(
          'service-worker.js'
        )
        .catch(
          console.error
        );

    }


    if (
      typeof setupInstallAndNotifyBanner ===
      'function'
    ) {

      setupInstallAndNotifyBanner();

    }

  </script></body></html>
