    window.OneSignalDeferred =
      window.OneSignalDeferred || [];

    OneSignalDeferred.push(
      async function(OneSignal) {

        try {

          await OneSignal.init({

            appId:
              "6ece3179-2303-4614-a752-18378c461644",

            serviceWorkerPath:
              "onesignal/OneSignalSDKWorker.js",

            serviceWorkerParam: {
              scope: "/onesignal/"
            }

          });

        } catch (error) {

          console.warn(
            "OneSignal não inicializado:",
            error
          );

        }

      }
    );

  </script></head><body>  <div
    id="snackbar"
    class="snackbar"
  ></div>  <!-- ======================================================
       TOPBAR
  ====================================================== -->  <div class="topbar"><div class="brand">

  <div class="mark"></div>

  <div>

    <div class="name">
      CleanSync
    </div>

    <div class="sub">
      CHAT DA LIMPEZA
    </div>

  </div>

</div>


<div class="who">

  <span class="sync-dot">

    <span class="dot"></span>

    ONLINE

  </span>


  <span id="topWhoName"></span>


  <button
    type="button"
    class="btn btn-ghost"
    onclick="goBack()"
  >
    Voltar
  </button>

</div>

  </div>  <!-- ======================================================
       CONTEÚDO
  ====================================================== -->  <main class="wrap"><div class="page-hero">

  <div class="eyebrow">
    COMUNICAÇÃO
  </div>

  <h1 id="chatTitle">
    Chat
  </h1>

  <p
    class="lede"
    id="chatSubtitle"
  >
    Conversa relacionada à limpeza.
  </p>

</div>



<!-- ====================================================
     INFORMAÇÕES DA LIMPEZA
==================================================== -->

<div
  class="chat-task-info"
  id="chatTaskInfo"
>

  <div class="chat-task-info-item">

    <span>
      REFERÊNCIA
    </span>

    <strong id="taskRef">
      —
    </strong>

  </div>


  <div class="chat-task-info-item">

    <span>
      DATA
    </span>

    <strong id="taskDate">
      —
    </strong>

  </div>


  <div class="chat-task-info-item">

    <span>
      STATUS
    </span>

    <strong id="taskStatus">
      —
    </strong>

  </div>

</div>



<!-- ====================================================
     CHAT
==================================================== -->

<section class="card chat-card">

  <div
    id="messages"
    class="chat-messages"
  >

    <div class="chat-loading">

      <div class="spinner"></div>

      <span>
        Carregando conversa...
      </span>

    </div>

  </div>



  <!-- ==================================================
       DIGITAÇÃO
  ================================================== -->

  <form
    id="messageForm"
    class="chat-input-area"
  >

    <textarea
      id="messageInput"
      rows="1"
      maxlength="2000"
      placeholder="Digite uma mensagem..."
      autocomplete="off"
      spellcheck="true"
    ></textarea>


    <button
      type="submit"
      class="btn btn-accent chat-send"
      id="sendButton"
      aria-label="Enviar mensagem"
      title="Enviar mensagem"
    >
      ➤
    </button>

  </form>

</section>

  </main>  <!-- ======================================================
       APP COMMON
  ====================================================== -->  <script src="app-common.js?v=11"></script>  <script>

    /* ======================================================
       ESTADO
    ====================================================== */

    let currentUser = null;

    let currentProfile = null;

    let conversationId = null;

    let cleaningId = null;

    let currentCleaning = null;

    let realtimeChannel = null;

    let sendingMessage = false;



    /* ======================================================
       INICIALIZAÇÃO
    ====================================================== */

    (async function initChat() {

      try {

        /*
         * O app-common define requireRole.
         *
         * Primeiro tentamos descobrir a sessão.
         */

        const params =
          new URLSearchParams(
            window.location.search
          );


        /*
         * O cliente/profissional deve abrir:
         *
         * chat.html?task=ID_DA_LIMPEZA
         */

        cleaningId =
          params.get('task');


        if (!cleaningId) {

          showError(
            'Nenhuma limpeza foi selecionada.'
          );

          return;

        }


        /*
         * Descobre o papel através
         * do perfil autenticado.
         */

        const ctx =
          await getChatContext();


        if (!ctx) {

          return;

        }


        currentUser =
          ctx.user;


        currentProfile =
          ctx.profile;


        updateTopUser();


        await initializeConversation();


      } catch (error) {

        console.error(
          'Erro ao inicializar chat:',
          error
        );


        showError(
          'Não foi possível abrir o chat.'
        );

      }

    })();



    /* ======================================================
       CONTEXTO DO USUÁRIO
    ====================================================== */

    async function getChatContext() {

      /*
       * Primeiro tenta usar requireRole('cliente')
       * porque ele retorna o contexto completo.
       */

      try {

        if (
          typeof requireRole ===
          'function'
        ) {

          const clienteCtx =
            await requireRole('cliente');


          /*
           * Se chegou aqui, é cliente.
           */

          if (clienteCtx) {

            return clienteCtx;

          }

        }

      } catch (error) {

        console.log(
          'Não é cliente, verificando profissional...'
        );

      }


      /*
       * Como requireRole pode redirecionar,
       * também tentamos recuperar diretamente
       * a sessão quando necessário.
       */

      try {

        const {
          data,
          error
        } =
          await sb.auth.getSession();


        if (error) {

          throw error;

        }


        if (
          !data ||
          !data.session ||
          !data.session.user
        ) {

          window.location.href =
            'index.html';

          return null;

        }


        const user =
          data.session.user;


        /*
         * Busca perfil.
         *
         * O projeto atual utiliza a tabela profiles.
         */

        const {
          data: profile,
          error: profileError
        } =
          await sb
            .from('profiles')
            .select('*')
            .eq(
              'id',
              user.id
            )
            .single();


        if (profileError) {

          console.error(
            profileError
          );

          throw profileError;

        }


        return {
          user,
          profile
        };


      } catch (error) {

        console.error(
          'Erro ao obter contexto:',
          error
        );


        if (
          typeof showError ===
          'function'
        ) {

          showError(
            'Sessão inválida ou expirada.'
          );

        } else {

          alert(
            'Sessão inválida ou expirada.'
          );

        }


        return null;

      }

    }



    /* ======================================================
       TOPO
    ====================================================== */

    function updateTopUser() {

      const element =
        document.getElementById(
          'topWhoName'
        );


      if (!element) return;


      element.textContent =
        (
          currentProfile &&
          (
            currentProfile.name ||
            currentProfile.full_name
          )
        ) ||
        (
          currentUser &&
          currentUser.email
        ) ||
        '';

    }



    /* ======================================================
       CRIAR / OBTER CONVERSA
    ====================================================== */

    async function initializeConversation() {

      try {

        /*
         * A função SQL deve garantir
         * que exista somente uma conversa
         * para cada limpeza.
         */

        const {
          data,
          error
        } =
          await sb.rpc(
            'create_cleaning_conversation',
            {
              p_cleaning_id:
                cleaningId
            }
          );


        if (error) {

          throw error;

        }


        /*
         * Algumas versões do Supabase
         * podem devolver UUID diretamente.
         */

        conversationId =
          data;


        if (
          !conversationId
        ) {

          throw new Error(
            'A conversa não foi criada.'
          );

        }


        /*
         * Carrega dados da limpeza.
         */

        await loadCleaning();


        /*
         * Carrega mensagens.
         */

        await loadMessages();


        /*
         * Ativa mensagens em tempo real.
         */

        subscribeToMessages();


        /*
         * Prepara campo de mensagem.
         */

        setupInput();


      } catch (error) {

        console.error(
          'initializeConversation:',
          error
        );


        showError(
          'Não foi possível abrir o chat: ' +
          (
            error.message ||
            'erro desconhecido'
          )
        );

      }

    }



    /* ======================================================
       CARREGAR LIMPEZA
    ====================================================== */

    async function loadCleaning() {

      const {
        data,
        error
      } =
        await sb
          .from('cleaning_requests')
          .select(`
            id,
            ref_code,
            client_name,
            client_email,
            address,
            date,
            time,
            status,
            professional_id,
            client_id,
            price,
            laundry_service
          `)
          .eq(
            'id',
            cleaningId
          )
          .single();


      if (error) {

        throw error;

      }


      currentCleaning =
        data;


      /*
       * Título.
       */

      const title =
        document.getElementById(
          'chatTitle'
        );


      if (title) {

        title.textContent =
          'Chat · ' +
          (
            data.ref_code ||
            'Limpeza'
          );

      }


      /*
       * Subtítulo.
       */

      const subtitle =
        document.getElementById(
          'chatSubtitle'
        );


      if (subtitle) {

        subtitle.textContent =
          data.address ||
          'Conversa da limpeza';

      }


      /*
       * Referência.
       */

      const ref =
        document.getElementById(
          'taskRef'
        );


      if (ref) {

        ref.textContent =
          data.ref_code ||
          '—';

      }


      /*
       * Data.
       */

      const date =
        document.getElementById(
          'taskDate'
        );


      if (date) {

        date.textContent =
          formatTaskDate(
            data.date,
            data.time
          );

      }


      /*
       * Status.
       */

      const status =
        document.getElementById(
          'taskStatus'
        );


      if (status) {

        status.textContent =
          formatStatus(
            data.status
          );

        status.dataset.status =
          data.status || '';

      }

    }



    /* ======================================================
       CARREGAR MENSAGENS
    ====================================================== */

    async function loadMessages() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      container.innerHTML = `

        <div class="chat-loading">

          <div class="spinner"></div>

          <span>
            Carregando mensagens...
          </span>

        </div>

      `;


      const {
        data,
        error
      } =
        await sb
          .from('messages')
          .select(`
            id,
            conversation_id,
            sender_id,
            content,
            created_at
          `)
          .eq(
            'conversation_id',
            conversationId
          )
          .order(
            'created_at',
            {
              ascending: true
            }
          );


      if (error) {

        showError(
          'Erro ao carregar mensagens: ' +
          error.message
        );

        return;

      }


      if (
        !data ||
        !data.length
      ) {

        renderEmptyChat();

        return;

      }


      container.innerHTML =
        data
          .map(
            renderMessage
          )
          .join('');


      scrollMessages();

    }



    /* ======================================================
       MENSAGEM
    ====================================================== */

    function renderMessage(message) {

      const mine =
        message.sender_id ===
        currentUser.id;


      const date =
        new Date(
          message.created_at
        );


      const time =
        date.toLocaleTimeString(
          'pt-BR',
          {
            hour: '2-digit',
            minute: '2-digit'
          }
        );


      const day =
        date.toLocaleDateString(
          'pt-BR',
          {
            day: '2-digit',
            month: '2-digit'
          }
        );


      return `

        <div
          class="chat-message ${mine ? 'mine' : 'theirs'}"
          data-message-id="${escapeAttribute(message.id)}"
        >

          <div class="chat-bubble">

            <div class="chat-content">
              ${escapeHtml(
                message.content || ''
              )}
            </div>

            <div class="chat-time">
              ${day} · ${time}
            </div>

          </div>

        </div>

      `;

    }



    /* ======================================================
       CHAT VAZIO
    ====================================================== */

    function renderEmptyChat() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      container.innerHTML = `

        <div class="chat-empty">

          <div class="chat-empty-icon">
            💬
          </div>

          <strong>
            Inicie a conversa
          </strong>

          <span>
            Envie uma mensagem para
            o outro participante desta limpeza.
          </span>

        </div>

      `;

    }



    /* ======================================================
       REALTIME
    ====================================================== */

    function subscribeToMessages() {

      if (
        !conversationId
      ) return;


      /*
       * Remove canal anterior.
       */

      if (
        realtimeChannel
      ) {

        sb.removeChannel(
          realtimeChannel
        );

        realtimeChannel =
          null;

      }


      realtimeChannel =
        sb
          .channel(
            'chat-' +
            conversationId +
            '-' +
            Date.now()
          )


          .on(

            'postgres_changes',

            {
              event: 'INSERT',

              schema: 'public',

              table: 'messages',

              filter:
                'conversation_id=eq.' +
                conversationId
            },

            payload => {

              if (
                !payload ||
                !payload.new
              ) {

                return;

              }


              const message =
                payload.new;


              /*
               * Evita duplicação.
               */

              if (
                document.querySelector(
                  `[data-message-id="${escapeAttribute(message.id)}"]`
                )
              ) {

                return;

              }


              const container =
                document.getElementById(
                  'messages'
                );


              if (!container) return;


              /*
               * Remove estado vazio.
               */

              const empty =
                container.querySelector(
                  '.chat-empty'
                );


              if (empty) {

                container.innerHTML =
                  '';

              }


              /*
               * Adiciona mensagem.
               */

              container.insertAdjacentHTML(
                'beforeend',
                renderMessage(
                  message
                )
              );


              scrollMessages();

            }

          )


          .subscribe(

            status => {

              console.log(
                'CleanSync Chat Realtime:',
                status
              );

              updateOnlineStatus(
                status
              );

            }

          );

    }



    /* ======================================================
       STATUS REALTIME
    ====================================================== */

    function updateOnlineStatus(
      status
    ) {

      const syncDot =
        document.querySelector(
          '.sync-dot'
        );


      if (!syncDot) return;


      if (
        status ===
        'SUBSCRIBED'
      ) {

        syncDot.innerHTML = `
          <span class="dot"></span>
          ONLINE
        `;

      }

      else {

        syncDot.innerHTML = `
          <span
            class="dot"
            style="opacity:.45"
          ></span>
          CONECTANDO
        `;

      }

    }



    /* ======================================================
       ENVIAR MENSAGEM
    ====================================================== */

    document
      .getElementById(
        'messageForm'
      )
      .addEventListener(
        'submit',
        sendMessage
      );


    async function sendMessage(
      event
    ) {

      event.preventDefault();


      if (
        sendingMessage
      ) {

        return;

      }


      if (
        !conversationId
      ) {

        showSnackbar(
          'Chat ainda não está pronto.'
        );

        return;

      }


      if (
        !currentUser
      ) {

        showSnackbar(
          'Sessão expirada.'
        );

        return;

      }


      const input =
        document.getElementById(
          'messageInput'
        );


      const button =
        document.getElementById(
          'sendButton'
        );


      if (
        !input ||
        !button
      ) {

        return;

      }


      const content =
        input.value.trim();


      if (!content) {

        return;

      }


      if (
        content.length >
        2000
      ) {

        showSnackbar(
          'A mensagem é muito longa.'
        );

        return;

      }


      sendingMessage =
        true;


      input.disabled =
        true;

      button.disabled =
        true;


      try {

        const {
          data,
          error
        } =
          await sb
            .from('messages')
            .insert({

              conversation_id:
                conversationId,

              sender_id:
                currentUser.id,

              content:
                content

            })
            .select(`
              id,
              conversation_id,
              sender_id,
              content,
              created_at
            `)
            .single();


        if (error) {

          throw error;

        }


        /*
         * O Realtime normalmente
         * adicionará a mensagem.
         *
         * Mas adicionamos imediatamente
         * caso o Realtime demore.
         */

        if (
          data &&
          !document.querySelector(
            `[data-message-id="${escapeAttribute(data.id)}"]`
          )
        ) {

          const container =
            document.getElementById(
              'messages'
            );


          const empty =
            container.querySelector(
              '.chat-empty'
            );


          if (empty) {

            container.innerHTML =
              '';

          }


          container.insertAdjacentHTML(
            'beforeend',
            renderMessage(data)
          );


          scrollMessages();

        }


        input.value =
          '';

        autoResizeInput();

        input.focus();


      } catch (error) {

        console.error(
          'Erro ao enviar:',
          error
        );


        showSnackbar(
          'Erro ao enviar mensagem: ' +
          (
            error.message ||
            'erro desconhecido'
          )
        );

      } finally {

        sendingMessage =
          false;

        input.disabled =
          false;

        button.disabled =
          false;

        input.focus();

      }

    }



    /* ======================================================
       INPUT
    ====================================================== */

    function setupInput() {

      const input =
        document.getElementById(
          'messageInput'
        );


      if (!input) return;


      input.addEventListener(
        'input',
        autoResizeInput
      );


      input.addEventListener(
        'keydown',
        event => {

          /*
           * Enter envia.
           *
           * Shift + Enter
           * cria nova linha.
           */

          if (
            event.key === 'Enter' &&
            !event.shiftKey
          ) {

            event.preventDefault();


            const form =
              document.getElementById(
                'messageForm'
              );


            if (form) {

              form.requestSubmit();

            }

          }

        }
      );


      /*
       * Foca no campo
       * depois que a conversa carrega.
       */

      setTimeout(
        () => input.focus(),
        150
      );

    }



    function autoResizeInput() {

      const input =
        document.getElementById(
          'messageInput'
        );


      if (!input) return;


      input.style.height =
        'auto';


      input.style.height =
        Math.min(
          input.scrollHeight,
          120
        ) +
        'px';

    }



    /* ======================================================
       SCROLL
    ====================================================== */

    function scrollMessages() {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) return;


      requestAnimationFrame(
        () => {

          container.scrollTop =
            container.scrollHeight;

        }
      );

    }



    /* ======================================================
       VOLTAR
    ====================================================== */

    function goBack() {

      const role =
        currentProfile &&
        currentProfile.role;


      if (
        role === 'professional' ||
        role === 'profissional' ||
        role === 'admin'
      ) {

        window.location.href =
          'profissional.html';

        return;

      }


      window.location.href =
        'cliente.html';

    }



    /* ======================================================
       STATUS
    ====================================================== */

    function formatStatus(
      status
    ) {

      switch (status) {

        case 'pending':
          return 'Pendente';

        case 'in-progress':
          return 'Em andamento';

        case 'completed':
          return 'Concluída';

        case 'cancelled':
          return 'Cancelada';

        default:
          return status || '—';

      }

    }



    /* ======================================================
       DATA
    ====================================================== */

    function formatTaskDate(
      date,
      time
    ) {

      if (!date) {

        return '—';

      }


      try {

        const d =
          new Date(
            date +
            (
              time
                ? 'T' + time
                : 'T00:00:00'
            )
          );


        if (
          Number.isNaN(
            d.getTime()
          )
        ) {

          return date;

        }


        const formatted =
          d.toLocaleDateString(
            'pt-BR',
            {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            }
          );


        return time
          ? formatted +
            ' · ' +
            time
          : formatted;

      } catch {

        return date;

      }

    }



    /* ======================================================
       ESCAPE HTML
    ====================================================== */

    function escapeHtml(
      value
    ) {

      return String(
        value ?? ''
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /'/g,
          '&#039;'
        );

    }



    /* ======================================================
       ESCAPE ATTRIBUTE
    ====================================================== */

    function escapeAttribute(
      value
    ) {

      return String(
        value ?? ''
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        );

    }



    /* ======================================================
       SNACKBAR
    ====================================================== */

    function showSnackbar(
      message
    ) {

      /*
       * Usa a função do app-common
       * se ela existir.
       */

      if (
        typeof window.showSnackbar ===
        'function'
      ) {

        window.showSnackbar(
          message
        );

        return;

      }


      const snackbar =
        document.getElementById(
          'snackbar'
        );


      if (!snackbar) {

        return;

      }


      snackbar.textContent =
        message;


      snackbar.classList.add(
        'show'
      );


      setTimeout(
        () => {

          snackbar.classList.remove(
            'show'
          );

        },
        3000
      );

    }



    /* ======================================================
       ERRO
    ====================================================== */

    function showError(
      message
    ) {

      const container =
        document.getElementById(
          'messages'
        );


      if (!container) {

        return;

      }


      container.innerHTML = `

        <div class="chat-error">

          <div class="chat-error-icon">
            ⚠️
          </div>

          <strong>
            Não foi possível abrir o chat
          </strong>

          <span>
            ${escapeHtml(message)}
          </span>

          <button
            type="button"
            class="btn btn-ghost"
            onclick="goBack()"
          >
            Voltar
          </button>

        </div>

      `;

    }



    /* ======================================================
       LIMPEZA DO REALTIME
    ====================================================== */

    window.addEventListener(
      'beforeunload',
      () => {

        if (
          realtimeChannel
        ) {

          sb.removeChannel(
            realtimeChannel
          );

        }

      }
    );

  </script>  <!-- ======================================================
       ESTILOS DO CHAT
  ====================================================== -->  <style>

    .chat-task-info {

      display:grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:10px;

      margin-bottom:14px;

    }


    .chat-task-info-item {

      min-width:0;

      padding:12px 14px;

      border:
        1px solid
        var(--border);

      border-radius:12px;

      background:
        var(--dark3);

    }


    .chat-task-info-item span {

      display:block;

      margin-bottom:5px;

      font-family:
        var(--mono);

      font-size:9px;

      letter-spacing:.08em;

      color:
        var(--muted);

    }


    .chat-task-info-item strong {

      display:block;

      overflow:hidden;

      text-overflow:ellipsis;

      white-space:nowrap;

      color:
        var(--cream);

      font-size:13px;

    }


    .chat-task-info-item
    strong[data-status="completed"] {

      color:
        #6ee7b7;

    }


    .chat-task-info-item
    strong[data-status="in-progress"] {

      color:
        var(--pink-light);

    }


    .chat-task-info-item
    strong[data-status="pending"] {

      color:
        #fbbf24;

    }


    .chat-card {

      padding:0;

      overflow:hidden;

    }


    .chat-messages {

      height:520px;

      overflow-y:auto;

      padding:24px;

      display:flex;

      flex-direction:column;

      gap:10px;

      background:

        radial-gradient(
          circle at 10% 20%,
          rgba(196,26,72,.06),
          transparent 35%
        ),

        var(--dark2);

      scroll-behavior:smooth;

    }


    .chat-message {

      display:flex;

      width:100%;

    }


    .chat-message.mine {

      justify-content:flex-end;

    }


    .chat-message.theirs {

      justify-content:flex-start;

    }


    .chat-bubble {

      max-width:
        min(
          75%,
          520px
        );

      padding:
        11px 14px;

      border-radius:16px;

      border:
        1px solid
        var(--border);

      background:
        var(--dark3);

      box-shadow:
        0 4px 14px
        rgba(0,0,0,.08);

    }


    .chat-message.mine
    .chat-bubble {

      background:
        linear-gradient(
          135deg,
          var(--wine),
          var(--pink)
        );

      border-color:
        rgba(255,255,255,.12);

      border-bottom-right-radius:
        5px;

    }


    .chat-message.theirs
    .chat-bubble {

      border-bottom-left-radius:
        5px;

    }


    .chat-content {

      font-size:14px;

      line-height:1.55;

      color:
        var(--cream);

      white-space:pre-wrap;

      overflow-wrap:anywhere;

    }


    .chat-time {

      margin-top:5px;

      font-family:
        var(--mono);

      font-size:9px;

      opacity:.65;

      text-align:right;

    }


    .chat-input-area {

      display:flex;

      align-items:flex-end;

      gap:10px;

      padding:14px;

      background:
        var(--dark3);

      border-top:
        1px solid
        var(--border);

    }


    .chat-input-area textarea {

      flex:1;

      resize:none;

      max-height:120px;

      min-height:44px;

      padding:
        12px 14px;

      border-radius:12px;

      border:
        1.5px solid
        var(--border-strong);

      background:
        var(--dark2);

      color:
        var(--cream);

      font-family:
        var(--sans);

      font-size:14px;

      line-height:1.4;

      box-sizing:border-box;

    }


    .chat-input-area textarea:focus {

      outline:none;

      border-color:
        var(--pink);

      box-shadow:
        0 0 0 3px
        rgba(196,26,72,.15);

    }


    .chat-input-area textarea:disabled {

      opacity:.6;

      cursor:not-allowed;

    }


    .chat-send {

      width:48px;

      min-width:48px;

      height:44px;

      padding:0;

      font-size:18px;

      display:flex;

      align-items:center;

      justify-content:center;

    }


    .chat-send:disabled {

      opacity:.5;

      cursor:not-allowed;

    }


    .chat-empty {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      text-align:center;

      color:
        var(--muted);

      gap:8px;

    }


    .chat-empty-icon {

      font-size:40px;

      margin-bottom:5px;

    }


    .chat-empty strong {

      color:
        var(--cream);

      font-family:
        var(--display);

      font-size:22px;

    }


    .chat-empty span {

      max-width:320px;

      font-size:12px;

      line-height:1.5;

    }


    .chat-loading {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      gap:12px;

      color:
        var(--muted);

      font-size:12px;

    }


    .chat-error {

      min-height:360px;

      display:flex;

      flex-direction:column;

      align-items:center;

      justify-content:center;

      text-align:center;

      gap:10px;

      padding:30px;

      color:
        var(--muted);

    }


    .chat-error-icon {

      font-size:40px;

    }


    .chat-error strong {

      color:
        var(--cream);

      font-family:
        var(--display);

      font-size:20px;

    }


    .chat-error span {

      max-width:480px;

      font-size:12px;

      line-height:1.5;

      overflow-wrap:anywhere;

    }


    @media(max-width:700px) {

      .chat-task-info {

        grid-template-columns:
          1fr;

      }


      .chat-messages {

        height:
          calc(
            100vh - 360px
          );

        min-height:380px;

        padding:16px;

      }


      .chat-bubble {

        max-width:85%;

      }


      .chat-input-area {

        position:sticky;

        bottom:0;

        padding:
          10px;

      }


      .chat-input-area textarea {

        font-size:14px;

      }

    }


    @media(max-width:420px) {

      .chat-messages {

        min-height:340px;

      }


      .chat-send {

        width:44px;

        min-width:44px;

      }

    }

  </style>  <!-- ======================================================
       SERVICE WORKER
  ====================================================== -->  <script>

    if (
      'serviceWorker' in navigator
    ) {

      navigator.serviceWorker
        .register(
          'service-worker.js'
        )
        .catch(
          console.error
        );

    }


    if (
      typeof setupInstallAndNotifyBanner ===
      'function'
    ) {

      setupInstallAndNotifyBanner();

    }

  </script></body></html>