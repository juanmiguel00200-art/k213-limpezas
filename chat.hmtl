<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8"><meta
name="viewport"
content="width=device-width, initial-scale=1.0, viewport-fit=cover"
/>

<title>CleanSync · Chat</title><link rel="preconnect" href="https://fonts.googleapis.com"><link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
  rel="stylesheet"
><link rel="manifest" href="manifest.json"><meta
name="theme-color"
content="#15151A"

«»

<link
  rel="stylesheet"
  href="style.css?v=10"
><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script></head><body><div id="snackbar" class="snackbar"></div><!-- =========================================================
     TOPO
========================================================= --><div class="topbar">  <div class="brand"><div class="mark"></div>

<div>
  <div class="name">CleanSync</div>
  <div class="sub">CHAT DA LIMPEZA</div>
</div>

  </div>  <div class="who"><span class="sync-dot">
  <span class="dot"></span>
  ONLINE
</span>

<span id="topWhoName"></span>

<button
  class="btn btn-ghost"
  type="button"
  onclick="goBack()"
>
  Voltar
</button>

  </div></div><!-- =========================================================
     CONTEÚDO
========================================================= --><div class="wrap">  <div class="page-hero"><div class="eyebrow">
  COMUNICAÇÃO
</div>

<h1 id="chatTitle">
  Chat
</h1>

<p
  class="lede"
  id="chatSubtitle"
>
  Conversa relacionada à limpeza.
</p>

  </div>  <!-- =======================================================
       CHAT
  ======================================================== -->  <div class="card chat-card"><div
  id="messages"
  class="chat-messages"
>

  <div class="chat-loading">

    <div class="loading-spinner"></div>

    <span>
      Carregando conversa...
    </span>

  </div>

</div>


<!-- =====================================================
     DIGITAÇÃO
====================================================== -->

<form
  id="messageForm"
  class="chat-input-area"
>

  <textarea
    id="messageInput"
    rows="1"
    maxlength="2000"
    placeholder="Digite uma mensagem..."
    autocomplete="off"
    aria-label="Mensagem"
  ></textarea>

  <button
    type="submit"
    class="btn btn-accent chat-send"
    id="sendButton"
    aria-label="Enviar mensagem"
  >
    ➤
  </button>

</form>

  </div></div><script src="app-common.js?v=10"></script><script>

/* ============================================================
   CleanSync — CHAT
   Compatível com:
   - app-common.js
   - cleaning_requests
   - conversations
   - messages
   - Realtime
============================================================ */


let currentUser = null;
let currentProfile = null;

let conversationId = null;
let cleaningId = null;

let chatRealtimeChannel = null;


/* ============================================================
   INICIALIZAÇÃO
============================================================ */

(async function initChat(){

  try {

    /*
      O seu app-common.js usa uma sessão própria
      armazenada em localStorage.

      Portanto NÃO usamos Supabase Auth aqui.
    */

    const session = getSession();

    if (!session) {

      window.location.href = 'index.html';

      return;

    }


    currentUser = {
      id: session.id,
      email: session.username || ''
    };


    currentProfile = {
      id: session.id,
      full_name: session.name || session.full_name || '',
      name: session.name || session.full_name || '',
      role: session.role || ''
    };


    /* ========================================================
       NOME NO TOPO
    ======================================================== */

    const topName =
      document.getElementById('topWhoName');

    if (topName) {

      topName.textContent =
        currentProfile.full_name ||
        currentProfile.name ||
        currentUser.email ||
        'Usuário';

    }


    /* ========================================================
       LIMPEZA VINDO DA URL
       
       Exemplos:
       
       chat.html?task=UUID
       chat.html?cleaning=UUID
    ======================================================== */

    const params =
      new URLSearchParams(
        window.location.search
      );


    cleaningId =
      params.get('task') ||
      params.get('cleaning') ||
      params.get('id');


    if (!cleaningId) {

      showError(
        'Nenhuma limpeza foi selecionada.'
      );

      return;

    }


    /* ========================================================
       ABRIR CHAT
    ======================================================== */

    await initializeConversation();

  }

  catch(error){

    console.error(
      'Erro ao iniciar chat:',
      error
    );

    showError(
      error?.message ||
      'Não foi possível iniciar o chat.'
    );

  }

})();


/* ============================================================
   INICIALIZAR CONVERSA
============================================================ */

async function initializeConversation(){

  /*
    Primeiro verificamos se a limpeza existe
    e se o usuário participa dela.
  */

  const {
    data: cleaning,
    error: cleaningError
  } = await sb
    .from('cleaning_requests')
    .select(`
      id,
      ref_code,
      client_name,
      address,
      date,
      time,
      professional_id,
      client_id,
      status
    `)
    .eq(
      'id',
      cleaningId
    )
    .single();


  if (cleaningError) {

    throw new Error(
      'Não foi possível encontrar esta limpeza: ' +
      cleaningError.message
    );

  }


  if (!cleaning) {

    throw new Error(
      'Limpeza não encontrada.'
    );

  }


  /* ==========================================================
     SEGURANÇA
     
     Somente cliente, profissional ou admin podem abrir.
  ========================================================== */

  const isAdmin =
    currentProfile.role === 'admin';


  const isClient =
    cleaning.client_id === currentUser.id;


  const isProfessional =
    cleaning.professional_id === currentUser.id;


  if (
    !isAdmin &&
    !isClient &&
    !isProfessional
  ){

    throw new Error(
      'Você não participa desta limpeza.'
    );

  }


  /* ==========================================================
     INTERFACE
  ========================================================== */

  updateCleaningHeader(
    cleaning
  );


  /* ==========================================================
     BUSCAR CONVERSA EXISTENTE
  ========================================================== */

  let {
    data: conversation,
    error: conversationError
  } = await sb
    .from('conversations')
    .select(`
      id,
      cleaning_id,
      client_id,
      professional_id,
      created_at
    `)
    .eq(
      'cleaning_id',
      cleaningId
    )
    .maybeSingle();


  if (conversationError) {

    throw new Error(
      'Erro ao procurar a conversa: ' +
      conversationError.message
    );

  }


  /* ==========================================================
     SE NÃO EXISTIR, CRIAR
  ========================================================== */

  if (!conversation) {

    const {
      data: newConversation,
      error: createError
    } = await sb
      .from('conversations')
      .insert({

        cleaning_id:
          cleaning.id,

        client_id:
          cleaning.client_id,

        professional_id:
          cleaning.professional_id

      })
      .select(`
        id,
        cleaning_id,
        client_id,
        professional_id,
        created_at
      `)
      .single();


    if (createError) {

      /*
        Pode acontecer de outra pessoa ter criado
        exatamente ao mesmo tempo.

        Então tentamos buscar novamente.
      */

      const retry =
        await sb
          .from('conversations')
          .select(`
            id,
            cleaning_id,
            client_id,
            professional_id,
            created_at
          `)
          .eq(
            'cleaning_id',
            cleaningId
          )
          .maybeSingle();


      if (retry.error || !retry.data) {

        throw new Error(
          'Não foi possível criar a conversa: ' +
          createError.message
        );

      }


      conversation =
        retry.data;

    }

    else {

      conversation =
        newConversation;

    }

  }


  conversationId =
    conversation.id;


  /* ==========================================================
     MENSAGENS
  ========================================================== */

  await loadMessages();


  /* ==========================================================
     REALTIME
  ========================================================== */

  subscribeToMessages();


  /* ==========================================================
     INPUT
  ========================================================== */

  setupInput();

}


/* ============================================================
   CABEÇALHO DA LIMPEZA
============================================================ */

function updateCleaningHeader(cleaning){

  const title =
    document.getElementById(
      'chatTitle'
    );

  const subtitle =
    document.getElementById(
      'chatSubtitle'
    );


  if (title) {

    title.textContent =
      'Chat · ' +
      (
        cleaning.ref_code ||
        'Limpeza'
      );

  }


  if (subtitle) {

    const address =
      cleaning.address ||
      'Conversa da limpeza';


    const date =
      cleaning.date
        ? formatDate(cleaning.date)
        : '';


    subtitle.textContent =
      date
        ? `${address} · ${date}`
        : address;

  }

}


/* ============================================================
   CARREGAR MENSAGENS
============================================================ */

async function loadMessages(){

  const container =
    document.getElementById(
      'messages'
    );


  if (!container) return;


  container.innerHTML = `

    <div class="chat-loading">

      <div class="loading-spinner"></div>

      <span>
        Carregando mensagens...
      </span>

    </div>

  `;


  const {
    data,
    error
  } = await sb
    .from('messages')
    .select(`
      id,
      conversation_id,
      sender_id,
      content,
      created_at
    `)
    .eq(
      'conversation_id',
      conversationId
    )
    .order(
      'created_at',
      {
        ascending: true
      }
    );


  if (error) {

    showError(
      'Erro ao carregar mensagens: ' +
      error.message
    );

    return;

  }


  if (
    !data ||
    data.length === 0
  ){

    renderEmptyChat();

    return;

  }


  container.innerHTML =
    data
      .map(
        message =>
          renderMessage(message)
      )
      .join('');


  scrollMessages();

}


/* ============================================================
   ESTADO VAZIO
============================================================ */

function renderEmptyChat(){

  const container =
    document.getElementById(
      'messages'
    );


  container.innerHTML = `

    <div class="chat-empty">

      <div class="chat-empty-icon">
        💬
      </div>

      <strong>
        Inicie a conversa
      </strong>

      <span>
        Envie uma mensagem para o
        outro participante desta limpeza.
      </span>

    </div>

  `;

}


/* ============================================================
   RENDERIZAR MENSAGEM
============================================================ */

function renderMessage(message){

  const mine =
    String(message.sender_id) ===
    String(currentUser.id);


  const date =
    new Date(
      message.created_at
    );


  const time =
    date.toLocaleTimeString(
      'pt-BR',
      {
        hour: '2-digit',
        minute: '2-digit'
      }
    );


  return `

    <div
      class="chat-message ${mine ? 'mine' : 'theirs'}"
      data-message-id="${escapeHtml(message.id)}"
    >

      <div class="chat-bubble">

        <div class="chat-content">
          ${escapeHtml(message.content)}
        </div>

        <div class="chat-time">
          ${time}
        </div>

      </div>

    </div>

  `;

}


/* ============================================================
   REALTIME
============================================================ */

function subscribeToMessages(){

  if (!conversationId) return;


  /* Remove canal anterior */

  if (chatRealtimeChannel){

    sb.removeChannel(
      chatRealtimeChannel
    );

    chatRealtimeChannel =
      null;

  }


  chatRealtimeChannel =
    sb
      .channel(
        'cleansync-chat-' +
        conversationId
      )


      .on(

        'postgres_changes',

        {
          event: 'INSERT',

          schema: 'public',

          table: 'messages',

          filter:
            'conversation_id=eq.' +
            conversationId

        },

        payload => {

          const message =
            payload.new;


          if (!message) return;


          /* Evitar duplicação */

          const existing =
            document.querySelector(
              `[data-message-id="${message.id}"]`
            );


          if (existing) return;


          const container =
            document.getElementById(
              'messages'
            );


          if (!container) return;


          /* Remove estado vazio */

          const empty =
            container.querySelector(
              '.chat-empty'
            );


          if (empty){

            container.innerHTML = '';

          }


          container.insertAdjacentHTML(
            'beforeend',
            renderMessage(message)
          );


          scrollMessages();

        }

      )


      .subscribe(
        status => {

          console.log(
            'CleanSync Chat:',
            status
          );

        }
      );

}


/* ============================================================
   ENVIAR MENSAGEM
============================================================ */

document
  .getElementById(
    'messageForm'
  )
  .addEventListener(
    'submit',
    sendMessage
  );


async function sendMessage(event){

  event.preventDefault();


  if (!conversationId){

    showSnackbar(
      'O chat ainda não está pronto.'
    );

    return;

  }


  const input =
    document.getElementById(
      'messageInput'
    );


  const button =
    document.getElementById(
      'sendButton'
    );


  if (!input) return;


  const content =
    input.value.trim();


  if (!content) return;


  if (content.length > 2000){

    showSnackbar(
      'A mensagem é muito grande.'
    );

    return;

  }


  input.disabled =
    true;

  button.disabled =
    true;


  try {

    const {
      data,
      error
    } = await sb
      .from('messages')
      .insert({

        conversation_id:
          conversationId,

        sender_id:
          currentUser.id,

        content:
          content

      })
      .select(`
        id,
        conversation_id,
        sender_id,
        content,
        created_at
      `)
      .single();


    if (error){

      throw error;

    }


    /*
      O Realtime também vai receber essa mensagem.

      Porém adicionamos imediatamente na tela
      para deixar a experiência mais rápida.
    */

    const existing =
      document.querySelector(
        `[data-message-id="${data.id}"]`
      );


    if (!existing){

      const container =
        document.getElementById(
          'messages'
        );


      const empty =
        container.querySelector(
          '.chat-empty'
        );


      if (empty){

        container.innerHTML = '';

      }


      container.insertAdjacentHTML(
        'beforeend',
        renderMessage(data)
      );


      scrollMessages();

    }


    input.value = '';

    autoResizeInput();

    input.focus();

  }

  catch(error){

    console.error(
      'Erro ao enviar:',
      error
    );


    showSnackbar(
      'Erro ao enviar mensagem: ' +
      (
        error?.message ||
        'tente novamente'
      )
    );

  }

  finally {

    input.disabled =
      false;

    button.disabled =
      false;

  }

}


/* ============================================================
   INPUT
============================================================ */

function setupInput(){

  const input =
    document.getElementById(
      'messageInput'
    );


  if (!input) return;


  input.addEventListener(
    'input',
    autoResizeInput
  );


  input.addEventListener(
    'keydown',
    event => {

      /*
        Enter = enviar

        Shift + Enter =
        nova linha
      */

      if (
        event.key === 'Enter' &&
        !event.shiftKey
      ){

        event.preventDefault();


        document
          .getElementById(
            'messageForm'
          )
          .requestSubmit();

      }

    }
  );

}


function autoResizeInput(){

  const input =
    document.getElementById(
      'messageInput'
    );


  if (!input) return;


  input.style.height =
    'auto';


  input.style.height =
    Math.min(
      input.scrollHeight,
      120
    ) + 'px';

}


/* ============================================================
   SCROLL
============================================================ */

function scrollMessages(){

  const container =
    document.getElementById(
      'messages'
    );


  if (!container) return;


  requestAnimationFrame(() => {

    container.scrollTop =
      container.scrollHeight;

  });

}


/* ============================================================
   VOLTAR
============================================================ */

function goBack(){

  if (
    currentProfile &&
    currentProfile.role === 'admin'
  ){

    window.location.href =
      'admin.html';

    return;

  }


  if (
    currentProfile &&
    (
      currentProfile.role ===
      'profissional' ||
      currentProfile.role ===
      'professional'
    )
  ){

    window.location.href =
      'profissional.html';

    return;

  }


  window.location.href =
    'cliente.html';

}


/* ============================================================
   ERRO
============================================================ */

function showError(message){

  const container =
    document.getElementById(
      'messages'
    );


  if (!container) return;


  container.innerHTML = `

    <div class="chat-error">

      <div class="chat-error-icon">
        ⚠️
      </div>

      <strong>
        Não foi possível abrir o chat
      </strong>

      <span>
        ${escapeHtml(message)}
      </span>

      <button
        type="button"
        class="btn btn-outline"
        onclick="goBack()"
      >
        Voltar
      </button>

    </div>

  `;

}


/* ============================================================
   LIMPEZA DO REALTIME
============================================================ */

window.addEventListener(
  'beforeunload',
  () => {

    if (chatRealtimeChannel){

      sb.removeChannel(
        chatRealtimeChannel
      );

      chatRealtimeChannel =
        null;

    }

  }
);

</script><style>

/* ==========================================================
   CHAT
========================================================== */

.chat-card{

  padding:0;

  overflow:hidden;

}


/* ==========================================================
   MENSAGENS
========================================================== */

.chat-messages{

  height:520px;

  overflow-y:auto;

  padding:24px;

  display:flex;

  flex-direction:column;

  gap:10px;

  background:
    radial-gradient(
      circle at 10% 20%,
      rgba(196,26,72,.06),
      transparent 35%
    ),

    var(--dark2);

}


/* ==========================================================
   MENSAGEM
========================================================== */

.chat-message{

  display:flex;

  width:100%;

}


.chat-message.mine{

  justify-content:flex-end;

}


.chat-message.theirs{

  justify-content:flex-start;

}


/* ==========================================================
   BALÃO
========================================================== */

.chat-bubble{

  max-width:min(
    75%,
    520px
  );

  padding:11px 14px;

  border-radius:16px;

  border:1px solid var(--border);

  background:var(--dark3);

  box-shadow:
    0 4px 14px
    rgba(0,0,0,.08);

}


.chat-message.mine
.chat-bubble{

  background:
    linear-gradient(
      135deg,
      var(--wine),
      var(--pink)
    );

  border-color:
    rgba(255,255,255,.12);

  border-bottom-right-radius:5px;

}


.chat-message.theirs
.chat-bubble{

  border-bottom-left-radius:5px;

}


/* ==========================================================
   TEXTO
========================================================== */

.chat-content{

  font-size:14px;

  line-height:1.55;

  color:var(--cream);

  white-space:pre-wrap;

  overflow-wrap:anywhere;

}


/* ==========================================================
   HORÁRIO
========================================================== */

.chat-time{

  margin-top:5px;

  font-family:var(--mono);

  font-size:9px;

  opacity:.65;

  text-align:right;

}


/* ==========================================================
   INPUT
========================================================== */

.chat-input-area{

  display:flex;

  gap:10px;

  padding:14px;

  background:var(--dark3);

  border-top:1px solid var(--border);

}


.chat-input-area textarea{

  flex:1;

  resize:none;

  max-height:120px;

  min-height:44px;

  padding:12px 14px;

  border-radius:12px;

  border:1.5px solid var(--border-strong);

  background:var(--dark2);

  color:var(--cream);

  font-family:var(--sans);

  font-size:14px;

  line-height:1.4;

}


.chat-input-area textarea:focus{

  outline:none;

  border-color:var(--pink);

  box-shadow:
    0 0 0 3px
    rgba(196,26,72,.15);

}


.chat-send{

  width:48px;

  min-width:48px;

  height:44px;

  padding:0;

  font-size:18px;

}


/* ==========================================================
   VAZIO
========================================================== */

.chat-empty{

  min-height:360px;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  text-align:center;

  color:var(--muted);

  gap:8px;

}


.chat-empty-icon{

  font-size:40px;

  margin-bottom:5px;

}


.chat-empty strong{

  color:var(--cream);

  font-family:var(--display);

  font-size:22px;

}


.chat-empty span{

  max-width:320px;

  font-size:12px;

  line-height:1.5;

}


/* ==========================================================
   LOADING
========================================================== */

.chat-loading{

  min-height:360px;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  gap:12px;

  color:var(--muted);

  font-size:13px;

}


.loading-spinner{

  width:28px;

  height:28px;

  border-radius:50%;

  border:3px solid var(--border);

  border-top-color:var(--pink);

  animation:
    chatSpin
    .8s linear infinite;

}


@keyframes chatSpin{

  to{

    transform:
      rotate(360deg);

  }

}


/* ==========================================================
   ERRO
========================================================== */

.chat-error{

  min-height:360px;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  text-align:center;

  gap:10px;

  padding:30px;

}


.chat-error-icon{

  font-size:42px;

}


.chat-error strong{

  color:var(--cream);

  font-size:18px;

}


.chat-error span{

  color:var(--muted);

  max-width:500px;

  font-size:13px;

  line-height:1.5;

}


/* ==========================================================
   MOBILE
========================================================== */

@media(max-width:600px){

  .chat-messages{

    height:
      calc(
        100vh - 310px
      );

    min-height:380px;

    padding:16px;

  }


  .chat-bubble{

    max-width:85%;

  }


  .chat-input-area{

    position:sticky;

    bottom:0;

  }


  .topbar{

    gap:8px;

  }

}

</style><script>

/* ============================================================
   SERVICE WORKER
============================================================ */

if ('serviceWorker' in navigator){

  navigator.serviceWorker
    .register(
      'service-worker.js'
    )
    .catch(
      console.error
    );

}

</script></body>
</html>